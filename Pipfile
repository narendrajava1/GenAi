[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]

# 🚀 FastAPI - Web framework for building APIs
fastapi = "*"

# ⚡ Uvicorn - ASGI server to run FastAPI apps
uvicorn = "*"

# 🧾 Pydantic - Data validation and request/response models
pydantic = "*"

# 🔐 python-dotenv - Load environment variables from .env file
python-dotenv = "*"

# Core GenAI
langchain = "*"
langchain-core = "*"
langchain-community = "*"

# LLM Integration
langchain-ollama = "*"
# 🤖 langchain-openai - Integration package to connect LangChain with OpenAI models (GPT-4, GPT-3.5, etc.)
langchain-openai = "*"
# UI
streamlit = "*"

# RAG Stack
langchain-text-splitters = "*"
langchain-huggingface = "*"
#ChromaDB for vector storage
#langchain-chroma = "*"
#chromadb = "*"

#Facebook AI Similarity Search
faiss-cpu = "*"

# Embeddings
sentence-transformers = "*"

# Document Processing
unstructured = "*"
"unstructured[pdf]" = "*"

# NLP Utilities
nltk = "*"

# Dev / Notebook
ipykernel = "*"
#Text to PDF generation
pypdf = "*"
fpdf = "*"

# Microsoft AutoGen AgentChat framework for building multi-agent conversational AI systems
autogen-agentchat = "*"

# AutoGen extensions with Ollama support for running local LLMs and integrating open-source models
"autogen-ext[ollama]" = "*"
[dev-packages]

[requires]
python_version = "3.12"